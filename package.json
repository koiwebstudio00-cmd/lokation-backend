{
  "name": "ubikka-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API de Ubikka",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:deploy": "tsx scripts/migrate-dev.ts",
    "db:generate": "prisma generate",
    "test:prepare": "tsx scripts/migrate-test.ts",
    "pilot:openai": "node --import tsx scripts/pilot-openai.mjs",
    "seed": "tsx prisma/seed.ts",
    "migrate:supabase": "tsx scripts/migrate-supabase.ts",
    "admin": "tsx scripts/admin-cli.ts",
    "zernio-adopt": "node dist/ops/zernio-adopt.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^6.10.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^6.4.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "prisma": "^6.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
