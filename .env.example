# App
NODE_ENV=development
PORT=3001

# PostgreSQL exclusivo de Ubikka. `docker compose up -d db` lo expone en 5433.
# La API usa app_rt (sin BYPASSRLS); migraciones y seed usan postgres.
DATABASE_URL=postgresql://app_rt:app_rt_dev@localhost:5433/ubikka_dev?schema=public
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5433/ubikka_dev?schema=public

# Test: crear `ubikka_test` en esta misma instancia antes de usar test:prepare.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/ubikka_test?schema=public

# Cliente OAuth de Google compartido por ambos paneles (sin client secret en backend).
GOOGLE_CLIENT_ID=

# Auth (F1) — generar con: openssl rand -hex 32
# URL exacta del superadmin (origen WebAuthn; HTTPS obligatorio en producción).
SUPER_ADMIN_URL=http://localhost:3003
# 32 bytes hex para cifrar TOTP. Generar con openssl rand -hex 32 y conservar.
# Obligatoria al usar 2FA en producción. No cambiarla sin migrar secretos.
# SECURITY_ENCRYPTION_KEY=
JWT_SECRET=
COOKIE_SECURE=false
# Orígenes del navegador autorizados, separados por coma. OBLIGATORIO en
# producción (la app no arranca sin esto). Ej:
# CORS_ORIGIN=https://app.ubikka.example,https://inmobiliaria-demo.ubikka.example
CORS_ORIGIN=
# lax | none | strict. Si el panel NO está en un subdominio del mismo dominio
# que la API (ej: panel en vercel.app), tiene que ser 'none' + COOKIE_SECURE=true,
# o el navegador no manda la cookie de sesión y el login no funciona.
COOKIE_SAMESITE=lax
# Para compartir la cookie entre subdominios: .ubikka.example
COOKIE_DOMAIN=

# Cloudflare R2 (F2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=property-images-dev
R2_PUBLIC_URL=

# SMTP / nodemailer: alternativa si RESEND_API_KEY está vacío.
# Producción requiere RESEND_API_KEY o SMTP_HOST y EMAIL_FROM propio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# URL del panel para links de invitación/reset y consultas
FRONT_URL=http://localhost:3000

# ── Agente de IA ─────────────────────────────────────────────────────────────
# Minutos HÁBILES antes de reasignar una derivación que nadie tomó.
HANDOFF_TIMEOUT_MIN=60
# Horario de atención (hora local) — el reloj del timeout se pausa fuera de él.
LABORAL_DESDE=9
LABORAL_HASTA=19
# Días laborables en formato cron (0 = domingo).
LABORAL_DIAS=1,2,3,4,5
# Valor temporal heredado. Antes de usar el agente, configurar horario por tenant.
TZ_OFFSET_HORAS=-3
# Fallback del link público que el agente le manda al lead, si el tenant no
# tiene config_sitio.url_publica cargado.
SITIO_PUBLICO_URL=
# Servicio nuevo: mismo secreto aleatorio (mínimo 32 caracteres) en backend y agent-ia.
# Activar un tenant de prueba por UUID; vacio conserva el recorrido anterior.
AGENT_SERVICE_URL=http://localhost:3100
AGENT_SERVICE_SECRET=
AGENT_CODE_TENANT_IDS=

# Migración de datos desde Supabase (scripts/migrate-supabase.ts)
# Connection string directa de Postgres: Supabase → Project Settings → Database
SUPABASE_DB_URL=
# URL del proyecto (para descargar fotos si property_images.url es un path)
SUPABASE_PROJECT_URL=

# ── Zernio (canales de mensajería: WhatsApp) ─────────────────────────────────
# Key full-access del team en Zernio (Settings → API Keys). Formato sk_ + 64 hex.
# Las keys restringidas (zrk_) NO sirven: no pueden gestionar webhooks ni el
# connect flow. Nunca se expone al panel ni se loggea.
ZERNIO_API_KEY=
# Secret que elegís VOS (`openssl rand -hex 32`) y le pasás a Zernio al crear
# el webhook (POST /v1/webhooks/settings, campo `secret`). Zernio firma cada
# entrega con HMAC-SHA256 en X-Zernio-Signature. Sin esto, /webhooks/zernio
# rechaza todo (falla cerrado).
ZERNIO_WEBHOOK_SECRET=
# URL del PANEL (no de la API): base para armar el redirect_url del connect
# flow. Sin barra final.
ZERNIO_REDIRECT_BASE_URL=http://localhost:3000
# Solo para pruebas locales del contrato heredado. Producción la rechaza.
# Webhook de n8n que retoma el flujo del agente después de que el worker
# registra el mensaje entrante (workflow heredado de n8n → nodo Webhook →
# Production URL). Sin esto los eventos quedan en la cola marcados como error.
N8N_WHATSAPP_WEBHOOK_URL=
# Ventana de agrupado de ráfagas (ms). Zernio manda un webhook POR MENSAJE; el
# worker espera este silencio antes de despachar la conversación a n8n, para que
# el lead que escribe entrecortado reciba UNA respuesta. Es latencia agregada
# antes de que el agente arranque.
ZERNIO_BUFFER_MS=8000

# Resend (prioridad sobre SMTP). Dominio remitente verificado en Resend.
RESEND_API_KEY=
# EMAIL_FROM="Ubikka <notificaciones@tu-dominio.com>"

# Imágenes en disco del VPS: activar en vez de R2.
STORAGE_DRIVER=r2
LOCAL_STORAGE_DIR=/var/lib/ubikka/media
# URL pública del backend; debe terminar en /media.
LOCAL_STORAGE_URL=http://localhost:3001/media
