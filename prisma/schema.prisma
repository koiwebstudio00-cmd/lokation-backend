// Modelo de datos — ver docs: diagrama-er.md, permisos-rls.md
// RLS, enums, helpers ctx_*() y roles de BD viven en SQL dentro de migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantEstado {
  activo
  suspendido

  @@map("tenant_estado")
}

enum UserRol {
  super_admin
  admin
  agente

  @@map("user_rol")
}

enum UserEstado {
  activo
  inactivo

  @@map("user_estado")
}

enum RentalPersonRole {
  comprador
  vendedor
  propietario
  inquilino
  garante
  contacto

  @@map("rental_person_role")
}

enum RentalContractStatus {
  borrador
  vigente
  finalizado

  @@map("rental_contract_status")
}

enum RentalServiceType {
  luz
  gas
  agua
  internet
  otro

  @@map("rental_service_type")
}

enum RentalServiceVisibility {
  interna
  inquilino
  propietario
  ambos

  @@map("rental_service_visibility")
}

enum MaintenanceStatus {
  abierta
  en_gestion
  resuelta
  cancelada

  @@map("maintenance_status")
}

enum MaintenancePriority {
  baja
  normal
  alta
  urgente

  @@map("maintenance_priority")
}

enum Operacion {
  venta
  alquiler
  ambos

  @@map("operacion_enum")
}

enum TipoPropiedad {
  monoambiente
  departamento
  casa
  duplex
  local_comercial
  oficina
  galpon
  estacionamiento
  terreno
  otro

  @@map("tipo_enum")
}

enum Moneda {
  ARS
  USD

  @@map("moneda_enum")
}

enum EstadoComercial {
  disponible
  reservado
  proximamente
  pausado
  vendida
  alquilada
  privado

  @@map("estado_enum")
}

// ── Enums de alquiler ────────────────────────────────────────────────────────
enum DestinoAlquiler {
  vivienda
  comercial
  profesional
  otro

  @@map("destino_enum")
}

enum PlazoContrato {
  // La UI muestra "12 meses"…; el valor sin dígito inicial es requisito de
  // Prisma (los miembros de enum no pueden empezar con número).
  meses_12
  meses_18
  meses_24
  meses_36
  otro

  @@map("plazo_contrato_enum")
}

enum AjusteAlquiler {
  trimestral
  cuatrimestral
  otro

  @@map("ajuste_enum")
}

enum IndiceAjuste {
  icl
  ipc
  fijo

  @@map("indice_ajuste_enum")
}

enum MascotasAlquiler {
  se_permiten
  no_se_permiten
  sin_especificar

  @@map("mascotas_enum")
}

enum AmobladoAlquiler {
  amoblado
  sin_amoblar
  sin_especificar

  @@map("amoblado_enum")
}

enum LeadCanal {
  web
  whatsapp
  instagram
  messenger
  manual

  @@map("lead_canal")
}

enum LeadEstado {
  nueva
  en_contacto
  ganada
  perdida

  @@map("lead_estado")
}

enum LeadClasificacion {
  potencial
  fantasma

  @@map("lead_clasificacion")
}

enum LeadTomadoOrigen {
  panel
  whatsapp_business_app
  sistema

  @@map("lead_tomado_origen")
}

enum ConversacionCanal {
  whatsapp
  web

  @@map("conversacion_canal")
}

enum ConversacionEstado {
  bot
  esperando_humano
  humano
  cerrada

  @@map("conversacion_estado")
}

enum MensajeRol {
  lead
  agente_ia
  vendedor
  sistema

  @@map("mensaje_rol")
}

enum MensajeTipo {
  texto
  audio
  imagen
  documento
  plantilla

  @@map("mensaje_tipo")
}

enum HandoffResultado {
  pendiente
  tomado
  timeout_reasignado
  rechazado

  @@map("handoff_resultado")
}

enum NotaOrigen {
  humano
  agente

  @@map("nota_origen")
}

/// Lo que quiere el LEAD. No confundir con Operacion, que es lo que ofrece la
/// propiedad: un lead que quiere *vender* no matchea nada del inventario.
enum LeadIntencion {
  comprar
  alquilar
  vender
  tasar
  consulta

  @@map("lead_intencion")
}

enum LeadTemperatura {
  fria
  tibia
  caliente

  @@map("lead_temperatura")
}

enum DeliveryEstado {
  pendiente
  entregada
  fallida

  @@map("delivery_estado")
}

enum FeedbackTipo {
  sugerencia
  error

  @@map("feedback_tipo")
}

enum FeedbackEstado {
  nuevo
  en_revision
  planificada
  resuelta
  descartada

  @@map("feedback_estado")
}

model Tenant {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                String
  slug                  String       @unique
  logoUrl               String?      @map("logo_url")
  configSitio           Json?        @map("config_sitio")
  sitePublished         Boolean      @default(false) @map("site_published")
  agentConfig           Json?        @map("agent_config")
  estado                TenantEstado @default(activo)
  authVersion           Int          @default(0) @map("auth_version")
  agentEnabled          Boolean      @default(false) @map("agente_activo")
  followupEnabled       Boolean      @default(true) @map("seguimiento_activo")
  followupFirstMessage  String       @default("Hola, ¿seguís interesado/a en la propiedad? Si querés te ayudo con cualquier duda.") @map("seguimiento_mensaje_1")
  followupSecondMessage String       @default("Te escribo por última vez por tu consulta. Si todavía te interesa, respondeme por acá y seguimos.") @map("seguimiento_mensaje_2")
  /// Profile de Zernio (1:1 con el tenant), creado lazy al conectar el primer
  /// canal. Ver plan-implementacion-zernio.md §4.3.
  zernioProfileId       String?      @map("zernio_profile_id")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  notifications       Notification[]
  users               User[]
  invitations         Invitation[]
  properties          Property[]
  images              PropertyImage[]
  leads               Lead[]
  leadNotes           LeadNote[]
  webhookEndpoints    WebhookEndpoint[]
  apiKeys             ApiKey[]
  conversations       Conversation[]
  conversationMsgs    ConversationMessage[]
  vendedoresAgente    VendedorAgente[]
  handoffs            Handoff[]
  channelAccounts     ChannelAccount[]
  feedbackItems       FeedbackItem[]
  feedbackAdjuntos    FeedbackAdjunto[]
  feedbackComentarios FeedbackComentario[]
  propertyCopyUsage   PropertyCopyUsage[]
  leadStatusHistory   LeadStatusHistory[]
  rentalPeople        RentalPerson[]
  rentalContracts     RentalContract[]
  rentalContractEvents RentalContractEvent[]
  rentalServiceAccounts RentalServiceAccount[]
  maintenanceRequests MaintenanceRequest[]
  maintenanceEvents MaintenanceEvent[]
  rentalCharges RentalCharge[]
  rentalPayments RentalPayment[]
  rentalAdjustments RentalAdjustment[]
  rentalSettlements RentalSettlement[]
  portalAccesses RentalPortalAccess[]
  portalInvitations RentalPortalInvitation[]
  portalSessions RentalPortalSession[]
  portalPasswordResets RentalPortalPasswordReset[]
  rentalInquiries RentalInquiry[]
  rentalDocuments RentalDocument[]

  @@map("tenants")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?    @map("tenant_id") @db.Uuid // null solo para super_admin
  nombre       String
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  authVersion  Int        @default(0) @map("auth_version")
  googleSubject String? @unique @map("google_subject")
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  notifications Notification[]
  security     UserSecurity?
  passkeys     Passkey[]
  rol          UserRol
  estado       UserEstado @default(activo)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                    Tenant?              @relation(fields: [tenantId], references: [id])
  invitationsSent           Invitation[]         @relation("inviter")
  refreshTokens             RefreshToken[]
  passwordResets            PasswordReset[]
  properties                Property[]
  leadsAssigned             Lead[]               @relation("leadAssignee")
  leadsTaken                Lead[]               @relation("leadTakenBy")
  leadNotes                 LeadNote[]
  apiKeysCreated            ApiKey[]             @relation("apiKeyCreator")
  conversations             Conversation[]       @relation("conversationVendedor")
  handoffs                  Handoff[]
  vendedorAgente            VendedorAgente?
  channelAccountsConectadas ChannelAccount[]     @relation("channelAccountConector")
  feedbackItems             FeedbackItem[]       @relation("feedbackAutor")
  feedbackComentarios       FeedbackComentario[] @relation("feedbackComentarioAutor")
  propertyCopyUsage         PropertyCopyUsage[]
  leadStatusHistory         LeadStatusHistory[]
  rentalPeopleCreated       RentalPerson[] @relation("rentalPersonCreator")
  rentalContractsCreated    RentalContract[] @relation("rentalContractCreator")
  rentalContractEvents      RentalContractEvent[] @relation("rentalContractEventActor")
  rentalServiceAccountsCreated RentalServiceAccount[]
  maintenanceRequestsCreated MaintenanceRequest[] @relation("maintenanceRequestCreator")
  maintenanceEventsCreated MaintenanceEvent[] @relation("maintenanceEventActor")
  rentalChargesCreated RentalCharge[] @relation("rentalChargeCreator")
  rentalPaymentsCreated RentalPayment[] @relation("rentalPaymentCreator")
  rentalPaymentsVoided RentalPayment[] @relation("rentalPaymentVoidActor")
  rentalAdjustmentsCreated RentalAdjustment[] @relation("rentalAdjustmentCreator")
  rentalSettlementsCreated RentalSettlement[] @relation("rentalSettlementCreator")
  rentalSettlementsPaid RentalSettlement[] @relation("rentalSettlementPaidActor")
  rentalSettlementsCancelled RentalSettlement[] @relation("rentalSettlementCancelledActor")
  portalInvitationsCreated RentalPortalInvitation[]
  rentalDocumentsUploaded RentalDocument[]
  rentalInquiriesAnswered RentalInquiry[]

  @@index([tenantId, email])
  @@map("users")
}

model Property {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  titulo         String
  operacion      Operacion
  tipo           TipoPropiedad
  precio         Decimal           @db.Decimal(14, 2)
  moneda         Moneda            @default(ARS)
  // operacion=ambos: `precio`/`moneda` = venta; estos dos = alquiler.
  precioAlquiler Decimal?          @map("precio_alquiler") @db.Decimal(14, 2)
  monedaAlquiler Moneda?           @map("moneda_alquiler")
  descripcion    String?
  direccion      String?
  puntoReferencia String? @map("punto_referencia")
  zona           String?
  ciudad         String?
  ambientes      Int?              @db.SmallInt
  dormitorios    Int?              @db.SmallInt
  banios         Int?              @db.SmallInt
  supCubierta    Decimal?          @map("sup_cubierta") @db.Decimal(10, 2)
  supTotal       Decimal?          @map("sup_total") @db.Decimal(10, 2)
  estado         EstadoComercial   @default(disponible)
  // Destacada: la sube al tope del listado web y del agente. Tope por vendedor.
  destacada      Boolean           @default(false)
  notas          String?
  requisitos     String?
  linkMaps       String?           @map("link_maps")
  // Campos de alquiler (nullable): no aplican a venta y se cargan opcionalmente.
  destino        DestinoAlquiler?
  plazoContrato  PlazoContrato?    @map("plazo_contrato")
  plazoOtro      String?           @map("plazo_otro")
  ajuste         AjusteAlquiler?
  ajusteOtro     String?           @map("ajuste_otro")
  indiceAjuste   IndiceAjuste?     @map("indice_ajuste")
  indiceFijoPct  Decimal?          @map("indice_fijo_pct") @db.Decimal(5, 2)
  expensas       String?
  mascotas       MascotasAlquiler?
  amoblado       AmobladoAlquiler?
  // Ubicación en el mapa (pin de Leaflet).
  lat            Decimal?          @db.Decimal(9, 6)
  lng            Decimal?          @db.Decimal(9, 6)
  slug           String            @unique @default("")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  images        PropertyImage[]
  leads         Lead[]
  conversations Conversation[]
  rentalContracts RentalContract[]
  rentalServiceAccounts RentalServiceAccount[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId])
  @@index([tenantId, estado])
  @@map("properties")
}

/// Contacto comercial interno. Los roles son una clasificación preliminar;
/// los permisos de portales se derivarán del contrato y sus vínculos vigentes.
model RentalPerson {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  createdById String             @map("created_by_id") @db.Uuid
  nombre      String
  email       String?
  telefono    String?
  roles       RentalPersonRole[] @default([])
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("rentalPersonCreator", fields: [createdById], references: [id])
  commercialLinks ClientOperation[]
  ownedContracts RentalContract[] @relation("rentalContractOwner")
  occupiedContracts RentalContract[] @relation("rentalContractTenant")
  portalAccesses RentalPortalAccess[]
  portalInvitations RentalPortalInvitation[]

  @@unique([id, tenantId])
  @@index([tenantId, nombre])
  @@map("rental_people")
}

/// Registro administrativo de un contrato. Un borrador no acredita firma ni
/// genera automáticamente cargos o cambios de publicación.
model RentalContract {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  propertyId     String               @map("property_id") @db.Uuid
  ownerPersonId  String               @map("owner_person_id") @db.Uuid
  tenantPersonId String               @map("tenant_person_id") @db.Uuid
  createdById    String               @map("created_by_id") @db.Uuid
  startDate      DateTime             @map("start_date") @db.Date
  endDate        DateTime             @map("end_date") @db.Date
  monthlyRent    Decimal              @map("monthly_rent") @db.Decimal(14, 2)
  currency       Moneda               @default(ARS)
  dueDay         Int                  @map("due_day") @db.SmallInt
  status         RentalContractStatus @default(borrador)
  closedAt       DateTime?            @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  owner        RentalPerson @relation("rentalContractOwner", fields: [ownerPersonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenantPerson RentalPerson @relation("rentalContractTenant", fields: [tenantPersonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy    User         @relation("rentalContractCreator", fields: [createdById], references: [id])
  events       RentalContractEvent[]
  maintenanceRequests MaintenanceRequest[]
  rentalCharges RentalCharge[]
  adjustments RentalAdjustment[]
  settlements RentalSettlement[]
  inquiries RentalInquiry[]
  documents RentalDocument[]

  @@unique([id, tenantId])
  @@unique([id, propertyId, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([propertyId, tenantId])
  @@index([ownerPersonId, tenantId])
  @@index([tenantPersonId, tenantId])
  @@map("rental_contracts")
}

model RentalContractEvent {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  contractId String     @map("contract_id") @db.Uuid
  actorId    String     @map("actor_id") @db.Uuid
  action     String
  details    Json
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract RentalContract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Cascade)
  actor    User           @relation("rentalContractEventActor", fields: [actorId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([contractId, createdAt(sort: Desc)])
  @@map("rental_contract_events")
}

model RentalServiceAccount {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  propertyId    String                  @map("property_id") @db.Uuid
  createdById   String                  @map("created_by_id") @db.Uuid
  type          RentalServiceType
  provider      String
  accountNumber String?                 @map("account_number")
  meterNumber   String?                 @map("meter_number")
  holderName    String?                 @map("holder_name")
  visibility    RentalServiceVisibility @default(interna)
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deactivatedAt DateTime?               @map("deactivated_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([tenantId, propertyId, active])
  @@index([createdById])
  @@map("rental_service_accounts")
}

model MaintenanceRequest {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  propertyId  String              @map("property_id") @db.Uuid
  contractId  String?             @map("contract_id") @db.Uuid
  createdById String              @map("created_by_id") @db.Uuid
  title       String
  description String
  priority    MaintenancePriority @default(normal)
  status      MaintenanceStatus   @default(abierta)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?           @map("resolved_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  contract  RentalContract? @relation(fields: [contractId, propertyId, tenantId], references: [id, propertyId, tenantId], onDelete: Restrict)
  createdBy User @relation("maintenanceRequestCreator", fields: [createdById], references: [id])
  events    MaintenanceEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([propertyId, tenantId])
  @@map("maintenance_requests")
}

model MaintenanceEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  fromState MaintenanceStatus? @map("from_state")
  toState   MaintenanceStatus @map("to_state")
  note      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request MaintenanceRequest @relation(fields: [requestId, tenantId], references: [id, tenantId], onDelete: Cascade)
  actor User @relation("maintenanceEventActor", fields: [actorId], references: [id])

  @@index([requestId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("maintenance_events")
}

/// Cargo mensual confirmado por la inmobiliaria. La generación es idempotente
/// por contrato y período; no se recalcula ni modifica luego de registrar cobros.
model RentalCharge {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  period      DateTime @db.Date
  dueDate     DateTime @map("due_date") @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  currency    Moneda
  concept     String   @default("alquiler")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract RentalContract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User @relation("rentalChargeCreator", fields: [createdById], references: [id])
  payments RentalPayment[]
  settlements RentalSettlement[]

  @@unique([id, tenantId])
  @@unique([id, contractId, tenantId])
  @@unique([contractId, period, concept])
  @@index([tenantId, dueDate])
  @@map("rental_charges")
}

/// Cobro manual. Un error se revierte con motivo; el registro original persiste.
model RentalPayment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  chargeId    String   @map("charge_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  paidAt      DateTime @map("paid_at") @db.Date
  method      String
  reference   String?
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason  String?   @map("void_reason")
  voidedById  String?   @map("voided_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge RentalCharge @relation(fields: [chargeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User @relation("rentalPaymentCreator", fields: [createdById], references: [id])
  voidedBy User? @relation("rentalPaymentVoidActor", fields: [voidedById], references: [id])

  @@index([tenantId, paidAt])
  @@index([chargeId, voidedAt])
  @@unique([tenantId, idempotencyKey])
  @@map("rental_payments")
}

/// Nuevo importe mensual a partir de un período; los cargos ya emitidos no se reescriben.
model RentalAdjustment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  effectivePeriod DateTime @map("effective_period") @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract RentalContract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User @relation("rentalAdjustmentCreator", fields: [createdById], references: [id])

  @@unique([contractId, effectivePeriod])
  @@index([tenantId, contractId, effectivePeriod(sort: Desc)])
  @@map("rental_adjustments")
}

